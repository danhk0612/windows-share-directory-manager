<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <AssemblyName>WindowsShareManager</AssemblyName>
    <RootNamespace>WindowsShareManager.Launcher</RootNamespace>
    <Authors>HAEKWANG DAN</Authors>
    <Product>Windows Share Manager Launcher</Product>
    <Description>Windows Share Manager용 .NET 10 Desktop Runtime 확인 런처</Description>
  </PropertyGroup>
</Project>
