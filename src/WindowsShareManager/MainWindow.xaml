<Window x:Class="WindowsShareManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Share Manager" Height="620" Width="1120"
        MinHeight="460" MinWidth="820"
        Loaded="Window_Loaded">
  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Padding="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Windows Share Manager" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock x:Name="ComputerInfoText" Margin="0,7,0,0" Foreground="#555"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="네트워크 진단" Click="Diagnostics_Click"/>
          <Button Content="새로 고침" Click="Refresh_Click" Margin="0"/>
        </StackPanel>
      </Grid>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="준비"/>
      </StatusBarItem>
    </StatusBar>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="공유 추가" Click="Add_Click"/>
      <Button x:Name="EditButton" Content="공유 수정" Click="Edit_Click" IsEnabled="False"/>
      <Button x:Name="DeleteButton" Content="공유 삭제" Click="Delete_Click"
              IsEnabled="False" Foreground="#B00020"/>
      <Separator Width="12" Opacity="0"/>
      <Button x:Name="CopyButton" Content="네트워크 경로 복사" Click="Copy_Click" IsEnabled="False"/>
      <Button x:Name="OpenButton" Content="폴더 열기" Click="Open_Click" IsEnabled="False"/>
    </StackPanel>

    <DataGrid x:Name="SharesGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              SelectionChanged="SharesGrid_SelectionChanged"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="공유 이름" Binding="{Binding Name}" Width="130"/>
        <DataGridTextColumn Header="실제 폴더 경로" Binding="{Binding Path}" Width="2*"/>
        <DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="160"/>
        <DataGridTextColumn Header="네트워크 경로" Binding="{Binding NetworkPath}" Width="190"/>
        <DataGridTextColumn Header="주요 접근 대상" Binding="{Binding PrincipalSummary}" Width="180"/>
        <DataGridTextColumn Header="권한" Binding="{Binding PermissionSummary}" Width="170"/>
        <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="90"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
