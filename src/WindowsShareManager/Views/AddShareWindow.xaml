<Window x:Class="WindowsShareManager.Views.AddShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="공유 추가" Width="620" Height="530"
        MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <TextBlock Text="폴더 경로" VerticalAlignment="Center"/>
    <TextBox x:Name="PathTextBox" Grid.Column="1" Margin="0,0,8,10" TextChanged="PathTextBox_TextChanged"/>
    <Button Grid.Column="2" Content="찾아보기" Click="Browse_Click" Margin="0,0,0,10"/>

    <TextBlock Grid.Row="1" Text="공유 이름" VerticalAlignment="Center"/>
    <TextBox x:Name="NameTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"/>

    <TextBlock Grid.Row="2" Text="설명" VerticalAlignment="Center"/>
    <TextBox x:Name="DescriptionTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"/>

    <TextBlock Grid.Row="3" Text="접근 대상" VerticalAlignment="Top" Margin="0,6,0,0"/>
    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
      <RadioButton x:Name="EveryoneRadio" Content="모든 사용자" IsChecked="True"
                   Checked="AccountMode_Changed" Margin="0,5,0,7"/>
      <RadioButton x:Name="SpecificRadio" Content="특정 사용자 또는 그룹"
                   Checked="AccountMode_Changed" Margin="0,0,0,7"/>
      <ComboBox x:Name="AccountComboBox" IsEditable="True" IsEnabled="False"
                DisplayMemberPath="DisplayName" TextSearch.TextPath="Name" Margin="0,0,0,10"/>
      <TextBlock Text="도메인 또는 Microsoft 계정은 계정 이름을 직접 입력할 수 있습니다."
                 Foreground="#666" FontSize="12" Margin="0,0,0,10"/>
    </StackPanel>

    <TextBlock Grid.Row="4" Text="권한" VerticalAlignment="Center"/>
    <ComboBox x:Name="PermissionComboBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
              SelectedIndex="0" Margin="0,0,0,10">
      <ComboBoxItem Content="읽기 전용" Tag="Read"/>
      <ComboBoxItem Content="읽기 및 쓰기" Tag="Change"/>
      <ComboBoxItem Content="모든 권한" Tag="Full"/>
    </ComboBox>

    <TextBlock x:Name="ValidationText" Grid.Row="5" Grid.ColumnSpan="3"
               Foreground="#B00020" TextWrapping="Wrap" Margin="0,8,0,8"/>

    <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="취소" IsCancel="True"/>
      <Button x:Name="CreateButton" Content="생성" IsDefault="True" Click="Create_Click" Margin="0"/>
    </StackPanel>
  </Grid>
</Window>
