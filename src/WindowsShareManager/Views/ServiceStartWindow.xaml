<Window x:Class="WindowsShareManager.Views.ServiceStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="서비스 시작 방식 선택"
        Width="650" Height="480"
        MinWidth="580" MinHeight="430"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="서비스 시작 방식 선택" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock x:Name="ServiceNameText" Margin="0,8,0,0" FontWeight="SemiBold"/>
      <TextBlock x:Name="CurrentStateText" Margin="0,4,0,0" Foreground="#555"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#FFF7E6" BorderBrush="#E0B25A"
            BorderThickness="1" Padding="12" Margin="0,14,0,12">
      <TextBlock x:Name="NoticeText" TextWrapping="Wrap"/>
    </Border>

    <StackPanel Grid.Row="2">
      <RadioButton x:Name="StartOnlyRadio"
                   Content="이번에만 시작 (권장)"
                   IsChecked="True"
                   Margin="0,7"/>
      <TextBlock Text="현재 시작 유형은 변경하지 않습니다."
                 Margin="26,-2,0,7" Foreground="#555"/>

      <RadioButton x:Name="ManualRadio"
                   Content="시작 유형을 수동으로 변경하고 시작"
                   Visibility="Collapsed"
                   Margin="0,7"/>
      <TextBlock x:Name="ManualDescription"
                 Text="사용 안 함 상태를 해제하고 필요할 때 시작할 수 있게 합니다."
                 Visibility="Collapsed"
                 Margin="26,-2,0,7" Foreground="#555"/>

      <RadioButton x:Name="AutomaticRadio"
                   Content="시작 유형을 자동으로 변경하고 시작"
                   Visibility="Collapsed"
                   Margin="0,7"/>
      <TextBlock x:Name="AutomaticDescription"
                 Text="Windows가 부팅할 때마다 이 서비스를 시작합니다."
                 Visibility="Collapsed"
                 Margin="26,-2,0,7" Foreground="#555"/>

      <RadioButton x:Name="DelayedAutomaticRadio"
                   Content="시작 유형을 자동(지연된 시작)으로 변경하고 시작"
                   Visibility="Collapsed"
                   Margin="0,7"/>
      <TextBlock x:Name="DelayedDescription"
                 Text="다른 자동 서비스가 시작된 뒤 이 서비스를 시작합니다."
                 Visibility="Collapsed"
                 Margin="26,-2,0,7" Foreground="#555"/>
    </StackPanel>

    <TextBlock x:Name="ResultText" Grid.Row="3"
               Foreground="#B00020" TextWrapping="Wrap" Margin="0,10,0,10"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="서비스 관리 열기" Click="OpenServices_Click"/>
      <Button Content="취소" IsCancel="True"/>
      <Button x:Name="ApplyButton" Content="선택한 방식으로 적용"
              IsDefault="True" Click="Apply_Click" Margin="0"/>
    </StackPanel>
  </Grid>
</Window>
