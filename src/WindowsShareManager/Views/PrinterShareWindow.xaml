<Window x:Class="WindowsShareManager.Views.PrinterShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프린터 공유 설정" Width="600" Height="390"
        MinWidth="540" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <TextBlock Text="프린터 이름" VerticalAlignment="Center"/>
    <TextBox x:Name="PrinterNameTextBox" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,10"/>

    <TextBlock Grid.Row="1" Text="공유 이름" VerticalAlignment="Center"/>
    <TextBox x:Name="ShareNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

    <TextBlock Grid.Row="2" Text="설명" VerticalAlignment="Center"/>
    <TextBox x:Name="CommentTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

    <TextBlock Grid.Row="3" Text="위치" VerticalAlignment="Center"/>
    <TextBox x:Name="LocationTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

    <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
      <TextBlock Text="프린터 자체, 드라이버와 포트는 변경하지 않습니다."
                 Foreground="#555" Margin="0,8,0,6"/>
      <TextBlock x:Name="ValidationText" Foreground="#B00020" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="취소" IsCancel="True"/>
      <Button x:Name="SaveButton" Content="공유 설정 저장" IsDefault="True"
              Click="Save_Click" Margin="0"/>
    </StackPanel>
  </Grid>
</Window>
