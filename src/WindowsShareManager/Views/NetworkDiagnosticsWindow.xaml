<Window x:Class="WindowsShareManager.Views.NetworkDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="공유 네트워크 상세 진단" Width="1180" Height="680"
        MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="공유 네트워크 상세 진단" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="SelectedAdapterText"
                 FontWeight="SemiBold"
                 Margin="0,7,0,0"/>
      <TextBlock Text="상태를 조회하고 관련 설정 화면을 엽니다. 안전한 일부 항목만 사용자 확인 후 자동 수정할 수 있습니다."
                 Foreground="#555" Margin="0,6,0,0"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="RefreshButton" Content="다시 진단" Click="Refresh_Click"/>
      <Button Content="닫기" IsCancel="True" Margin="0"/>
    </StackPanel>

    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="#555"/>

    <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserSortColumns="True" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="점검 항목" Binding="{Binding Name}" Width="190"/>
        <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="90"/>
        <DataGridTextColumn Header="결과" Binding="{Binding Detail}" Width="2*"/>
        <DataGridTextColumn Header="설명 및 팁" Binding="{Binding Tip}" Width="2.4*"/>
        <DataGridTemplateColumn Header="관련 설정" Width="135">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="{Binding ActionLabel}"
                      Tag="{Binding ActionKey}"
                      Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Click="OpenSetting_Click"
                      Margin="4" Padding="8,3"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="조치" Width="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="{Binding FixLabel}"
                      Tag="{Binding FixKey}"
                      Visibility="{Binding CanFix, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Click="ApplyFix_Click"
                      Margin="4" Padding="8,3"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
