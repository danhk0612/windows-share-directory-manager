<Window x:Class="WindowsShareManager.Views.EditShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="공유 수정" Width="760" Height="590"
        MinWidth="650" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <TextBlock Text="공유 이름" VerticalAlignment="Center"/>
    <TextBox x:Name="NameTextBox" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,9"/>
    <TextBlock Grid.Row="1" Text="폴더 경로" VerticalAlignment="Center"/>
    <TextBox x:Name="PathTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,9"/>
    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
               Text="공유 이름이나 폴더 경로를 변경하려면 기존 공유를 삭제한 뒤 새 공유를 생성하세요."
               Foreground="#666" FontSize="12" Margin="0,0,0,12"/>
    <TextBlock Grid.Row="3" Text="설명" VerticalAlignment="Center"/>
    <TextBox x:Name="DescriptionTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>
    <Button Grid.Row="4" Grid.Column="1" Content="설명 저장" HorizontalAlignment="Right"
            Click="SaveDescription_Click" Margin="0,0,0,12"/>

    <GroupBox Grid.Row="5" Grid.ColumnSpan="2" Header="SMB 접근 권한">
      <DataGrid x:Name="PermissionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                SelectionMode="Single" Margin="8">
        <DataGrid.Columns>
          <DataGridTextColumn Header="계정 이름" Binding="{Binding AccountName}" Width="*"/>
          <DataGridTextColumn Header="허용/거부" Binding="{Binding AccessControlDisplay}" Width="110"/>
          <DataGridTextColumn Header="권한 수준" Binding="{Binding PermissionDisplay}" Width="160"/>
        </DataGrid.Columns>
      </DataGrid>
    </GroupBox>

    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,10">
      <Button Content="접근 계정 추가" Click="AddPermission_Click"/>
      <Button Content="선택 계정 권한 변경" Click="ChangePermission_Click"/>
      <Button Content="선택 계정 제거" Click="RemovePermission_Click" Foreground="#B00020"/>
    </StackPanel>

    <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#555" Margin="0,0,14,0"/>
      <Button Content="닫기" IsCancel="True" Margin="0"/>
    </StackPanel>
  </Grid>
</Window>
