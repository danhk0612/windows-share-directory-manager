<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>WindowsShareManager</AssemblyName>
    <RootNamespace>WindowsShareManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.0</Version>
    <Authors>HAEKWANG DAN</Authors>
    <Product>Windows Share Manager</Product>
    <Description>Windows 11용 로컬 SMB 공유 폴더 GUI 관리 도구</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
  </ItemGroup>
</Project>
